# Copy this file to .env and fill in the values. Never commit .env.

# Database (local default matches docker-compose.yml).
# Free plan: your Neon connection string (use the "direct", non-pooled one).
# The job queue lives in this database too, so no Redis is needed.
DATABASE_URL=postgresql://dualflow:dualflow@localhost:5432/dualflow

# Dashboard login (Phase 0: single owner account)
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-to-a-long-password
# Random 32+ character string used to sign login cookies. Generate: openssl rand -base64 32
SESSION_SECRET=

# Where the dashboard finds the API
API_URL=http://localhost:4000
# Shared secret so only the dashboard can call the API. Generate: openssl rand -base64 32
INTERNAL_API_KEY=

# ---------- AI (research + scripts) ----------
# AI_PROVIDER = mock   practice data, free, no key (start here)
#             = gemini Google Gemini FREE tier (free plan). Get a key at aistudio.google.com
#             = claude Anthropic Claude (paid, best quality, for later)
AI_PROVIDER=mock
GEMINI_API_KEY=
# Optional: GEMINI_MODEL=gemini-flash-latest
# Your free daily request limit (look it up in AI Studio). Making stops here and continues tomorrow.
GEMINI_DAILY_REQUESTS=20
# GEMINI_SEARCH=off  (only if Google Search does not work with your free key)
ANTHROPIC_API_KEY=
# Backup name if your host hides ANTHROPIC_* variables (e.g. Claude Code cloud):
# DUALFLOW_ANTHROPIC_API_KEY=
# Claude model: claude-haiku-5-5 (budget) or claude-opus-5-5 (quality).
AI_MODEL=claude-haiku-5-5

# ---------- Voice ----------
# mock  = practice voice (beeps at each word), free, no key
# edge  = FREE Edge TTS voices, no key (needs Python + ffmpeg, see README)
# azure = Azure neural voices. Free "F0" tier = 500,000 characters a month.
VOICE_PROVIDER=mock
# Optional Edge voices: EDGE_VOICE_NE=ne-NP-SagarNeural (male)  EDGE_VOICE_EN=en-US-GuyNeural
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# F0 = free tier (stops at 90% of the free characters). S0 = paid tier.
AZURE_SPEECH_TIER=F0
# AZURE_VOICE_NE=ne-NP-HemkalaNeural
# AZURE_VOICE_EN=en-US-JennyNeural

# ---------- Files ----------
# local = this computer's disk (folder STORAGE_DIR, default "storage")
# r2    = Cloudflare R2, free 10 GB (needed on the free plan)
STORAGE=local
# STORAGE_DIR=storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=dualflow
# Delete files of published/failed stories after this many days.
RETENTION_DAYS=30

# ---------- Worker ----------
# forever = keep running (your computer). once = do the waiting jobs, then stop (GitHub Actions).
WORKER_MODE=forever
WORKER_CONCURRENCY=2

# ---------- "Run now" button (free plan, optional) ----------
# A fine-grained GitHub token for ONLY this repo with "Actions: Read and write".
GITHUB_REPO=
GITHUB_DISPATCH_TOKEN=
GITHUB_REF=main
