# Copy this file to .env and fill in the values. Never commit .env.

# Database and queue (local defaults match docker-compose.yml)
DATABASE_URL=postgresql://dualflow:dualflow@localhost:5432/dualflow
REDIS_URL=redis://localhost:6379

# Dashboard login (Phase 0: single owner account)
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-to-a-long-password
# Random 32+ character string used to sign login cookies. Generate: openssl rand -base64 32
SESSION_SECRET=

# Where the dashboard finds the API
API_URL=http://localhost:4000
# Shared secret so only the dashboard can call the API. Generate: openssl rand -base64 32
INTERNAL_API_KEY=

# AI providers (used from Phase 1)
# PRACTICE MODE: AI_MODE=mock makes fake research and scripts (free, no key needed).
# Remove it (or leave it empty) to use real Claude with your API key.
AI_MODE=mock
ANTHROPIC_API_KEY=
# Backup name if your host hides ANTHROPIC_* variables (e.g. Claude Code cloud):
# DUALFLOW_ANTHROPIC_API_KEY=
# Budget mode (default) = claude-haiku-5-5, about 4 cents per Nepali + English pair.
# Quality mode = claude-opus-5-5. Switch when your channels earn money.
AI_MODEL=claude-haiku-5-5

# Voice (Phase 1B)
# mock  = practice voice (beeps at each word), free, no key needed
# azure = real Azure neural voices. Free "F0" tier = 500,000 characters a month.
VOICE_PROVIDER=mock
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# F0 = free tier (cost counted as $0). S0 = paid tier (counted at $15 per 1M characters).
AZURE_SPEECH_TIER=F0
# Optional: change the voices
# AZURE_VOICE_NE=ne-NP-HemkalaNeural
# AZURE_VOICE_EN=en-US-JennyNeural

# Where audio, subtitles and videos are saved (on this computer, free).
# STORAGE_DIR=storage
