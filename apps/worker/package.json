{
  "name": "@dualflow/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "start": "tsx src/index.ts",
    "once": "WORKER_MODE=once tsx src/index.ts",
    "cleanup": "tsx src/cleanup.ts",
    "typecheck": "tsc --noEmit",
    "check-keys": "tsx src/check-keys.ts",
    "demo-story": "tsx src/demo-story.ts"
  },
  "dependencies": {
    "@dualflow/ai": "workspace:*",
    "@dualflow/db": "workspace:*",
    "@dualflow/queue": "workspace:*",
    "@dualflow/shared": "workspace:*",
    "@dualflow/storage": "workspace:*",
    "@dualflow/voice": "workspace:*",
    "aws4fetch": "^1.0.20"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
